# Obrigatória. Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 quando o site estiver atrás de HTTPS (cookies de sessão só trafegam criptografados).
COOKIE_SECURE=0

# Quantos backups manter em backups/ (os mais antigos são apagados).
BACKUP_MANTER=14

# 1 para ativar o modo debug ao rodar "python app.py" (nunca em produção).
FLASK_DEBUG=0
